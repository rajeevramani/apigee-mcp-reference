<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="oauth-prm-endpoint">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Allow</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <HTTPProxyConnection>
    <BasePath>/.well-known/oauth-protected-resource/mcp</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="oauth-prm-endpoint">
    <TargetEndpoint>oauth-prm-endpoint</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
