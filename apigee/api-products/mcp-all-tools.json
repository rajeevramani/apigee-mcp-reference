{
  "name": "mcp-all-tools",
  "displayName": "MCP All Tools",
  "description": "Access to documentation and API catalogue search tools.",
  "approvalType": "auto",
  "attributes": [{"name": "access", "value": "internal"}],
  "environments": ["eval"],
  "payloadOperationGroup": {
    "operationConfigs": [
      {"apiSource": "test-mcp", "operations": [{"operation": "tools/list"}], "quota": {"limit": "100", "interval": "1", "timeUnit": "minute"}},
      {"apiSource": "test-mcp", "operations": [{"operation": "tools/call/documentation_search"}], "quota": {"limit": "100", "interval": "1", "timeUnit": "minute"}},
      {"apiSource": "test-mcp", "operations": [{"operation": "tools/call/api_catalogue_search"}], "quota": {"limit": "100", "interval": "1", "timeUnit": "minute"}}
    ]
  }
}
