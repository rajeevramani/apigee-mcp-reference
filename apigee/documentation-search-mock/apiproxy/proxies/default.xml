<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="documentation-search">
      <Request>
        <Step>
          <Name>RF-Missing-Query</Name>
          <Condition>(request.queryparam.query = null) or (request.queryparam.query = "")</Condition>
        </Step>
        <Step><Name>OAS-Validate-Request</Name></Step>
        <Step><Name>AM-Mock-Documentation-Response</Name></Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/documentation/search") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="documentation-section-get">
      <Request>
        <Step><Name>OAS-Validate-Request</Name></Step>
        <Step><Name>AM-Mock-Documentation-Section</Name></Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/documentation/sections/*/*") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="openapi-spec-get">
      <Request>
        <Step><Name>OAS-Validate-Request</Name></Step>
        <Step><Name>AM-Mock-OpenAPI-Spec</Name></Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/documentation/specs/*") and (request.verb = "GET")</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/developer-intelligence/v1</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="no-target"/>
</ProxyEndpoint>
