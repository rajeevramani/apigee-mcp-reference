<APIProxy revision="1" name="documentation-search-mock">
  <DisplayName>Documentation Content Mock</DisplayName>
  <Description>Apigee-generated search, Markdown section, and OpenAPI responses for documentation MCP tools.</Description>
  <BasePaths>/developer-intelligence/v1</BasePaths>
  <Policies>
    <Policy>AM-Mock-Documentation-Response</Policy>
    <Policy>AM-Mock-Documentation-Section</Policy>
    <Policy>AM-Mock-OpenAPI-Spec</Policy>
    <Policy>OAS-Validate-Request</Policy>
    <Policy>RF-Missing-Query</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>oas://documentation-search-reverse-proxy.openapi.yaml</Resource>
  </Resources>
  <TargetEndpoints/>
</APIProxy>
