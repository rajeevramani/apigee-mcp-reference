<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="api-catalogue-search">
      <Request>
        <Step><Name>AM-Disable-Path-Suffix</Name></Step>
      </Request>
      <Response>
        <Step><Name>AM-Mock-Api-Catalogue-Response</Name></Step>
      </Response>
      <Condition>(proxy.pathsuffix MatchesPath "/search") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/api-catalogue/v1</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
